# HELIO Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Connection String)
MONGODB_URI=mongodb://127.0.0.1:27017/helio_db

# Authentication
JWT_SECRET=helio_enterprise_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Gemini AI Health Assistant
GEMINI_API_KEY=your_gemini_api_key_here
