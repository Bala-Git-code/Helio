# ============================================================================
# HELIO Enterprise Medication Intelligence Platform - Environment Example
# ============================================================================

# 1. Server & Runtime Infrastructure
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# 2. Security & Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=http://localhost:5173

# 3. Database Persistence (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/helio_db

# 4. Stateful Redis Infrastructure
# Backing store for connect-redis session persistence and 24-hour pairing codes (HL-XXXX-XXXX)
REDIS_URL=redis://127.0.0.1:6379

# 5. Stateful Session Engine (Zero-JWT & Zero-Password Architecture)
SESSION_SECRET=helio_stateful_enterprise_session_secret_change_in_production
# COOKIE_DOMAIN=.heliohealth.io

# 6. Federated Google OAuth 2.0 Authentication (Sole Provider)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# 7. Gemini AI Health & Interaction Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
